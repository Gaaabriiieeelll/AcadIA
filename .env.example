# Gere uma chave com: npx auth secret
# Também é possível usar: openssl rand -base64 32
AUTH_SECRET="substitua-por-uma-chave-aleatoria"

# Credenciais do cliente OAuth do tipo "Aplicativo da Web" no Google Cloud.
AUTH_GOOGLE_ID="seu-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="seu-client-secret"

# NextAuth v4 usa esta URL para construir os retornos OAuth.
NEXTAUTH_URL="http://localhost:3000"

# Separe vários endereços por vírgula. O MVP deve manter uma lista restrita.
ALLOWED_EMAILS="seu-email-pessoal-de-teste@gmail.com"

# Defina true somente quando quiser aceitar qualquer conta Google autenticada.
# Quando ativa, esta opção substitui ALLOWED_EMAILS e ALLOW_ACADEMIC_EMAIL.
ALLOW_ANY_GOOGLE_EMAIL="false"

# Mantenha false enquanto o AcadIA não tiver autorização institucional do IFPB.
ALLOW_ACADEMIC_EMAIL="false"

# Prisma Postgres: use a conexao pooled na aplicacao e a direta nas migracoes.
DATABASE_URL="postgres://usuario:senha@pooled.db.prisma.io:5432/postgres?sslmode=require"
DIRECT_URL="postgres://usuario:senha@db.prisma.io:5432/postgres?sslmode=require"

# Recomendações inteligentes de videoaulas. Mantenha as chaves somente no servidor.
OPENAI_API_KEY="sua-chave-da-openai"
OPENAI_RECOMMENDATION_MODEL="gpt-5.4-mini"
YOUTUBE_API_KEY="sua-chave-da-youtube-data-api"

# Alertas pelo WhatsApp com Evolution API v2.
EVOLUTION_API_URL="https://evolution.seu-dominio.com"
EVOLUTION_API_KEY="sua-chave-da-evolution-api"
EVOLUTION_INSTANCE_NAME="acadia"

# Somente estes e-mails autenticados podem solicitar o QR da instância global.
WHATSAPP_ADMIN_EMAILS="responsavel@gmail.com"

# A Vercel envia CRON_SECRET automaticamente ao cron em Authorization: Bearer.
CRON_SECRET="gere-uma-chave-aleatoria-forte"

# Compatibilidade com agendadores externos ou chamadas manuais (opcional na Vercel).
WHATSAPP_JOB_SECRET="gere-uma-chave-aleatoria-forte"

# Web Push. Gere o par uma única vez com: npx web-push generate-vapid-keys
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY="chave-publica-vapid"
WEB_PUSH_VAPID_PRIVATE_KEY="chave-privada-vapid"
WEB_PUSH_VAPID_SUBJECT="mailto:responsavel@seu-dominio.com"

# Protege o endpoint chamado pelo agendador de notificações do navegador.
BROWSER_PUSH_JOB_SECRET="gere-outra-chave-aleatoria-forte"

# Protege a verificação aprofundada GET /api/health?ready=1.
HEALTHCHECK_SECRET="gere-outra-chave-aleatoria-forte"

# Identificador opcional exibido no health check (commit, tag ou versao).
APP_VERSION="local"

# Recurso opcional separado da versão web. No Vercel, mantenha ausente ou false.
ANDROID_WIDGET_ENABLED="false"
